  "import_instructions": {
    "target_map": {
      "name": "The Continent",
      "map_type": "continent",
      "artwork": "campaign/maps/continent_atlas.png"
    },
    "create_location_for_each_marker": true,
    "marker_location_link": "Synchronize markers by source_id and preserve the linked campaign_locations.id when a marker is renamed.",
    "resolve_campaign_id": "Use the authenticated GM's active campaign_id; do not hard-code a campaign UUID.",
    "upsert_key": "Stable map_source_id and per-marker/per-overlay source_id, scoped to the authenticated campaign.",
    "visibility": "Each marker explicitly declares player_visible. The 15 approved major places are public; GM notes remain private. No political or geographic overlays are included because the current draft polygons are not reliable boundaries. Add overlays only after classifying and mapping them according to atlas_overlay_standards.md.",
    "caution": "Do not create or expose the GM-only dwarven underground route to Dragonstone. Do not add minor settlement markers to the continental layer merely to populate empty space; place them on their appropriate regional maps.",
    "marker_navigation": {
      "current_behavior": "Atlas marker click currently selects marker only; it does not navigate to a map.",
      "recommended_behavior": "On marker activation, if exactly one child map of the selected map has the same location_id as the marker and has artwork, navigate to that child map. Otherwise show/select marker normally.",
      "tallowmere_hierarchy": [
        "Continent map: parent_map_id=null",
        "Tallowmere regional map: parent_map_id=continent map; location_id=Tallowmere location id",
        "Tallowmere city map: parent_map_id=regional map; location_id=Tallowmere location id"
      ],
      "breadcrumb_behavior": "Preserve navigation back from city to region to continent.",
      "child_map_match": "Use location_id/location_source_id association rather than name matching when linking a marker to a child map."
    },
    "coordinate_policy": "Do not treat normalized coordinates as surveyed geography. The Tallowmere and Dragonstone anchors reflect the GM's latest saved positions in the live atlas and have been copied to this source file; other coordinates remain approximate. Visually review all positions against authoritative artwork before treating them as surveyed. Regional and city layers must not be added here merely to fill space.",
    "tallowmere_region": "The Tallowmere regional layer is prepared as a structured content specification, and approved regional artwork is stored at campaign/maps/tallowmere_regional.png. Importable marker coordinates remain pending visual calibration against that artwork. Do not fabricate coordinates."
  }
